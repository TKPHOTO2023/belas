# Postgres connection string (Neon, Supabase, Railway, or local).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bela"

# Long random string used to sign login sessions: openssl rand -hex 32
SESSION_SECRET=""

# Public URL of this deployment; voice-provider webhooks are sent to
# $APP_URL/api/webhooks/vapi
APP_URL="http://localhost:3000"

# Vapi (https://dashboard.vapi.ai -> API Keys)
VAPI_API_KEY=""
# Public key, used by the browser "Test call" button.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""
# Shared secret Vapi sends in the x-vapi-secret header on webhooks.
VAPI_WEBHOOK_SECRET=""

# First platform admin, created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@bela.ai"
SEED_ADMIN_PASSWORD="change-me-now"
