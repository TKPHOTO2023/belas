    "@vapi-ai/web": "2.7.1",
    "bcryptjs": "3.0.3",
    "jose": "6.2.14",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
